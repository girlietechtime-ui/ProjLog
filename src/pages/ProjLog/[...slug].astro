---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ProjPost from '../../layouts/projpost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('projlog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'projlog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<ProjPost {...post.data}>
	<Content />
</ProjPost>
